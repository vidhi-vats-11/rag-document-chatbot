# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# ---------- LLM ----------
# "openai" = OpenAI or any OpenAI-compatible API: Google Gemini (default, free tier), Ollama...
# "anthropic" = the Anthropic API
LLM_PROVIDER=openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=replace-with-your-api-key
# Other models (same provider and key) the user may pick per question, comma-separated.
# LLM_MODEL is always included and is the default. Example for Gemini:
# LLM_MODEL_CHOICES=gemini-3.5-flash
LLM_MODEL_CHOICES=
# Only for OpenAI-compatible servers. Default: Google Gemini
#   (https://generativelanguage.googleapis.com/v1beta/openai/; LLM_MAX_RETRIES=1 saves free quota).
#   Ollama: http://localhost:11434/v1     Empty (LLM_BASE_URL=) = OpenAI itself.
# LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
# Anthropic only: low | medium | high | xhigh | max (higher = more thorough, slower, costlier)
LLM_EFFORT=low
# Anthropic only: if a request is declined by a safety classifier, retry on a fallback model
ANTHROPIC_ENABLE_FALLBACKS=true

# ---------- Embeddings ----------
# local = models run on this computer (default). api = an OpenAI-compatible embedding API using
# LLM_BASE_URL + LLM_API_KEY, e.g. EMBEDDING_MODEL=gemini-embedding-001 (used on Vercel; no re-ranking).
EMBEDDING_PROVIDER=local
# The default model. Changing it after indexing requires a new CHROMA_COLLECTION (or re-indexing).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
# Models the user may pick per upload (comma-separated, free, run locally; downloaded on first use).
# Each model gets its own Chroma collection, because vectors from different models can't be mixed.
EMBEDDING_MODEL_CHOICES=sentence-transformers/all-MiniLM-L6-v2,sentence-transformers/multi-qa-MiniLM-L6-cos-v1,sentence-transformers/all-mpnet-base-v2,sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------- Re-ranking ----------
# Fetch RERANK_CANDIDATES chunks by vector search, re-score them with a cross-encoder,
# keep the best TOP_K. RERANK_ENABLED is the default; the user can switch it per question.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_CANDIDATES=20

# ---------- Answer cache ----------
# Reuse the answer when the same question is asked again (same meaning + same passages found):
# instant, and no LLM request is used. Cleared with DELETE /api/v1/chat/cache.
ANSWER_CACHE_ENABLED=true
# How alike two questions must be (0..1). Keep it high: "store open?" vs "store close?" scores 0.86.
ANSWER_CACHE_MIN_SIMILARITY=0.95
ANSWER_CACHE_MAX_ENTRIES=1000

# ---------- Storage ----------
# Postgres with pgvector instead of the local files below (SQLite + ChromaDB + uploads folder).
# Needed on hosts without a shared disk, e.g. Vercel + Neon (which sets it for you).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# UPLOAD_DIR=data/uploads
# CHROMA_DB_DIR=data/chroma_db
# METADATA_DB_PATH=data/documents.sqlite3
CHROMA_COLLECTION=document_chunks

# ---------- Uploads / chunking / retrieval ----------
MAX_UPLOAD_SIZE_MB=20
# Index uploads on a background thread so the browser doesn't wait (true/false).
BACKGROUND_INDEXING=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# "Pass mark" (cosine similarity). If even the best match scores below this, the question is
# treated as unrelated and the LLM is skipped; otherwise the top-K chunks are sent to the LLM.
MIN_RELEVANCE_SCORE=0.15
# Conversation memory: how many earlier question/answer pairs go with a follow-up question.
CHAT_HISTORY_TURNS=6
# "Summarize this document" reads the document's first N chunks in order (not just TOP_K matches).
SUMMARY_MAX_CHUNKS=40

# ---------- OCR ----------
# tesseract = the local Tesseract program (default). llm = the LLM reads the image (Gemini can),
# for hosts without Tesseract such as Vercel. Each scanned page then costs one LLM request.
OCR_PROVIDER=tesseract
# Leave unset to find `tesseract` on PATH. macOS (Homebrew): /opt/homebrew/bin/tesseract
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
# Default OCR language. The web page lets you pick another per upload.
# Extra languages: `brew install tesseract-lang`. Combine with "+", e.g. hin+eng.
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MIN_CHARS_PER_PAGE=50

LOG_LEVEL=INFO
